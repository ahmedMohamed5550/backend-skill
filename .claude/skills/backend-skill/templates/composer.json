{
    "name": "company/backend-project",
    "type": "project",
    "description": "Standardized Company Laravel Backend Project",
    "keywords": [
        "laravel",
        "backend",
        "api"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "agence104/livekit-server-sdk": "^1.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "darkaonline/l5-swagger": "^8.6",
        "doctrine/dbal": "^3.8",
        "docusign/esign-client": "^8.8",
        "firebase/php-jwt": "^7.0",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.0.1",
        "kreait/laravel-firebase": "^7.2",
        "laravel/cashier": "^15.6",
        "laravel/nightwatch": "^1.30",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13",
        "laravel/pulse": "^1.7",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.2",
        "laravel/telescope": "^5.2",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.5",
        "livewire/livewire": "^3.6",
        "maatwebsite/excel": "^3.1",
        "nnjeim/world": "^1.1",
        "nyholm/psr7": "^1.8",
        "opcodesio/log-viewer": "*",
        "openspout/openspout": "^5.13",
        "phpmailer/phpmailer": "^6.8",
        "pinoox/numera": "*",
        "pragmarx/google2fa-laravel": "*",
        "predis/predis": "^2.2",
        "promphp/prometheus_client_php": "^2.11.0",
        "pusher/pusher-php-server": "^7.2",
        "ringcentral/ringcentral-php": "^3.0.1",
        "sendgrid/sendgrid": "^8.1",
        "sentry/sentry-laravel": "^4.13",
        "setasign/fpdf": "^1.9",
        "setasign/fpdi": "^2.6",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-passkeys": "^1.8",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-prometheus": "^1.4",
        "spomky-labs/otphp": "*",
        "stripe/stripe-php": "*",
        "twilio/sdk": "^7.13"
    },
    "require-dev": {
        "doctrine/annotations": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.19",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.9",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
